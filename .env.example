# ─── Database ──────────────────────────────────────────────────────────────
# Local SQLite file by default. For production use a libSQL/Turso URL:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./.data/app.db
DATABASE_AUTH_TOKEN=

# Public base URL (used for Stripe redirect URLs)
APP_URL=http://localhost:3000
# Calendar "today" for meal plans and logs
APP_TIMEZONE=Asia/Kolkata

# ─── AI image generation (optional) ────────────────────────────────────────
# Enables finished-dish and cooking-step illustrations (OpenAI GPT Image).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# ─── Natural-voice narration & translation (optional) ──────────────────────
# Sarvam AI (preferred for Indian languages): TTS + recipe translation.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Alternative TTS provider, used only if SARVAM_API_KEY is empty.
GOOGLE_TTS_API_KEY=

# ─── Payments (optional) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_INR=199
# Shows a "simulate Premium" toggle. Always on in development; never set in production.
ALLOW_DEV_PREMIUM=

# Password for the optional demo account created by `npm run db:seed -- --demo`
DEMO_PASSWORD=

# ─── Health data: Google Health API (optional) ─────────────────────────────
# Fitbit / Fitbit Air / Pixel Watch data. Create a Google Cloud project, enable the
# Google Health API, add an OAuth web client with redirect URI
#   <APP_URL>/api/health/google/callback
# While the consent screen is in "Testing", add users as test users (max 100);
# Google expires their refresh tokens after 7 days, so they reconnect weekly.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# 32 random bytes, base64 — encrypts stored OAuth tokens: openssl rand -base64 32
HEALTH_TOKEN_KEY=

# ─── Exercise demo clips: Google Veo 3.1 (optional) ────────────────────────
# Gemini API key from Google AI Studio. Clips are generated from the admin page
# (/admin/media), reviewed, and only approved clips are shown to users.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-fast-generate-preview
VEO_DAILY_LIMIT=20
# Comma-separated emails of accounts that may open /admin pages
ADMIN_EMAILS=
