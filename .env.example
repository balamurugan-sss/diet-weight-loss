# ─── Database ──────────────────────────────────────────────────────────────
# Local SQLite file by default. For production use a libSQL/Turso URL:
#   DATABASE_URL=libsql://<db>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token>
DATABASE_URL=file:./.data/app.db
DATABASE_AUTH_TOKEN=

# Public base URL (used for Stripe redirect URLs)
APP_URL=http://localhost:3000
# Calendar "today" for meal plans and logs
APP_TIMEZONE=Asia/Kolkata

# ─── AI image generation (optional) ────────────────────────────────────────
# Enables finished-dish and cooking-step illustrations (OpenAI GPT Image).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# ─── Natural-voice narration & translation (optional) ──────────────────────
# Sarvam AI (preferred for Indian languages): TTS + recipe translation.
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Alternative TTS provider, used only if SARVAM_API_KEY is empty.
GOOGLE_TTS_API_KEY=

# ─── Payments (optional) ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
PREMIUM_PRICE_INR=199
# Shows a "simulate Premium" toggle. Always on in development; never set in production.
ALLOW_DEV_PREMIUM=

# Password for the optional demo account created by `npm run db:seed -- --demo`
DEMO_PASSWORD=
