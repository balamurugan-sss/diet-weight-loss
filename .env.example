# All variables below are optional — the app is fully functional with none set.
# See README.md "Environment variables" for what each one unlocks.

# Enables real OpenAI-backed chat replies (gpt-4o-mini) and food image recognition
# (GPT-4o vision). Without it, the app falls back to a fully working rule-based
# chat coach and shows a clear "not configured" message for image recognition.
OPENAI_API_KEY=

# Enables real Stripe Checkout sessions on the Premium page. Without it, the
# checkout button shows a clear setup message and a labeled dev-only toggle
# lets you simulate premium access to test gating.
STRIPE_SECRET_KEY=
